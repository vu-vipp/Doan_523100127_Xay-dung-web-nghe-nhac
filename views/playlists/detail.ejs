<%- include('../partials/header',{title,active:'playlists'}) %>
<a href="/playlists" class="back-link">← Playlist của tôi</a>
<section class="playlist-heading"><div class="playlist-heading-cover">♫</div><div><span class="eyebrow">PLAYLIST CÁ NHÂN</span><h1><%= playlist.TenPlaylist %></h1><p><%= viewer.HoTen %> · <%= songs.length %> bài hát</p></div></section>
<section class="panel playlist-management"><h2>Quản lý playlist</h2><form action="/playlists/<%= playlist.MaPlaylist %>/rename" method="post" class="create-form"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" value="<%= playlist.TenPlaylist %>" maxlength="150" required aria-label="Tên playlist"><button class="btn btn-outline" type="submit">Đổi tên</button></form><form action="/playlists/<%= playlist.MaPlaylist %>/delete" method="post" class="spaced-form" data-confirm="Xóa playlist này? Các bài hát trong thư viện sẽ không bị xóa."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger" type="submit">Xóa playlist</button></form></section>
<div class="section-heading"><h2>Bài hát trong playlist</h2></div><div class="song-list"><% songs.forEach(s=>{ %><div class="playlist-song"><div class="playlist-song-main"><%- include('../partials/song-row',{song:s}) %></div><form method="post" action="/playlists/<%= playlist.MaPlaylist %>/remove-song" data-confirm="Xóa bài hát khỏi playlist?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="songId" value="<%= s.MaBaiHat %>"><button class="btn btn-outline btn-small" type="submit">Xóa khỏi playlist</button></form></div><% }) %><% if(!songs.length){ %><div class="empty">Playlist còn trống. <a class="text-link" href="/songs">Mở thư viện</a>, chọn bài hát rồi nhấn “+ Thêm vào playlist” ở trang chi tiết bài hát.</div><% } %></div>
<%- include('../partials/footer') %>
