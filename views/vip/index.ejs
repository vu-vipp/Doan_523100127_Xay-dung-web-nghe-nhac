<%- include('../partials/header',{title,active:'vip'}) %>
<section class="vip-hero"><div class="vip-star">✦</div><span class="eyebrow">NÂNG TẦM TRẢI NGHIỆM</span><h1>WAVE <em>VIP</em></h1><p>Mở khóa kho nhạc VIP. Chọn gói, hoàn tất thanh toán mô phỏng và chờ Admin xác nhận.</p><div class="vip-benefits"><span>✓ Mở khóa bài hát VIP</span><span>✓ Quản lý playlist</span><span>✓ Phân quyền trên máy chủ</span></div></section>
<% if(activeVIP){ %><div class="notice-box success">✦ VIP đang có hiệu lực: <strong><%= activeVIP.TenGoi %></strong>. Hết hạn: <%= new Date(activeVIP.NgayKetThuc).toLocaleString('vi-VN') %>.</div><% } %>
<div class="section-heading"><h2>Chọn gói phù hợp</h2></div><div class="plan-grid"><% plans.forEach((plan,i)=>{ %><div class="plan-card <%= i===1?'featured':'' %>"><span class="plan-label"><%= i===1?'PHỔ BIẾN':'WAVE VIP' %></span><h2><%= plan.TenGoi %></h2><p><%= plan.MoTa||'Trải nghiệm âm nhạc VIP' %></p><div class="plan-price"><%= formatPrice(plan.Gia) %></div><span class="plan-duration"><%= plan.ThoiHan %> ngày sử dụng</span><div class="plan-features">✓ Nghe bài hát VIP<br>✓ Quyền được kiểm tra khi phát<br>✓ Quản lý playlist cá nhân</div><% if(viewer){ %><form method="post" action="/vip/subscribe"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="planId" value="<%= plan.MaGoi %>"><button class="btn <%= i===1?'btn-primary':'btn-outline' %> btn-block" type="submit" <%= activeVIP?'disabled':'' %>>Đăng ký gói →</button></form><% } else { %><a class="btn <%= i===1?'btn-primary':'btn-outline' %> btn-block" href="/login">Đăng nhập để đăng ký</a><% } %></div><% }) %><% if(!plans.length){ %><p class="empty">Chưa có gói VIP. Hãy chạy lệnh thêm dữ liệu mẫu.</p><% } %></div>
<div class="notice-box">ⓘ Đây là đồ án học tập: thanh toán được <strong>mô phỏng</strong>, không có giao dịch tiền thật. Sau khi xác nhận thanh toán mô phỏng, yêu cầu được chuyển tới Admin để duyệt trước khi quyền VIP có hiệu lực.</div>
<% if(viewer){ %><section class="section"><div class="section-heading"><h2>Lịch sử đăng ký của tôi</h2></div><div class="panel table-scroll"><table class="data-table"><thead><tr><th>Mã</th><th>Gói</th><th>Giá</th><th>Bắt đầu</th><th>Kết thúc</th><th>Trạng thái</th></tr></thead><tbody><% history.forEach(h=>{ %><tr><td>#<%= h.MaDangKy %></td><td><%= h.TenGoi %></td><td><%= formatPrice(h.Gia) %></td><td><%= new Date(h.NgayBatDau).toLocaleDateString('vi-VN') %></td><td><%= new Date(h.NgayKetThuc).toLocaleDateString('vi-VN') %></td><td><span class="status-tag <%= h.TrangThai==='DA_XAC_NHAN'?'tag-green':h.TrangThai==='HUY'?'tag-red':'tag-yellow' %>"><%= h.TrangThai==='DA_XAC_NHAN'?'Đã xác nhận':h.TrangThai==='HUY'?'Đã hủy':'Chờ xác nhận' %></span></td></tr><% }) %><% if(!history.length){ %><tr><td colspan="6">Chưa có lượt đăng ký nào.</td></tr><% } %></tbody></table></div></section><% } %>
<%- include('../partials/footer') %>
