<%- include('../partials/header',{title,active:'admin'}) %>
<section class="page-heading"><span class="eyebrow">BẢNG ĐIỀU KHIỂN</span><h1>Quản trị WAVE</h1><p>Quản lý bài hát và duyệt các yêu cầu VIP đã xác nhận thanh toán mô phỏng.</p></section>
<div class="admin-metrics"><div class="metric-card"><span>Tổng bản ghi bài hát</span><strong><%= totalSongs %></strong><small>Bao gồm cả bài đã khóa/ẩn</small></div><div class="metric-card"><span>Yêu cầu VIP chờ</span><strong><%= pending.length %></strong><small>Cần Admin kiểm tra và xác nhận</small></div></div>
<section class="section" id="songs"><div class="section-heading"><h2>Quản lý bài hát</h2><a href="/admin/songs/new" class="btn btn-primary">+ Thêm bài hát</a></div>
<div class="admin-filter" aria-label="Lọc danh sách bài hát theo loại">
  <a href="/admin?type=ALL#songs" class="admin-filter-link <%= filter==='ALL'?'is-active':'' %>" <%= filter==='ALL'?'aria-current="true"':'' %>>Tất cả</a>
  <a href="/admin?type=VIP#songs" class="admin-filter-link <%= filter==='VIP'?'is-active':'' %>" <%= filter==='VIP'?'aria-current="true"':'' %>>✦ VIP</a>
  <a href="/admin?type=FREE#songs" class="admin-filter-link <%= filter==='FREE'?'is-active':'' %>" <%= filter==='FREE'?'aria-current="true"':'' %>>Miễn phí</a>
  <span class="admin-filter-count"><%= filteredCount %> bản ghi phù hợp<%= filteredCount>songs.length?' · Hiển thị '+songs.length+' bản ghi mới nhất':'' %></span>
</div>
<div class="panel table-scroll"><table class="data-table"><thead><tr><th>ID</th><th>Bài hát</th><th>Ca sĩ</th><th>Quyền</th><th>Trạng thái</th><th>Lượt nghe</th><th>Thao tác</th></tr></thead><tbody>
<% songs.forEach(s=>{ const active=Boolean(s.TrangThai); %><tr><td>#<%= s.MaBaiHat %></td><td><% if(active){ %><a class="text-link" href="/admin/music/<%= s.MaBaiHat %>"><%= s.TenBaiHat %></a><% } else { %><%= s.TenBaiHat %><% } %></td><td><%= s.TenCaSi %></td><td><span class="status-tag <%= s.IsVIP?'tag-yellow':'tag-green' %>"><%= s.IsVIP?'VIP':'FREE' %></span></td><td><span class="status-tag <%= active?'tag-green':'tag-red' %>"><%= active?'Hoạt động':'Đã khóa/ẩn' %></span></td><td><%= s.LuotNghe %></td><td><div class="table-actions"><% if(active){ %><button class="btn btn-outline btn-small play-trigger" type="button" aria-label="Nghe thử <%= s.TenBaiHat %>" data-play="<%= s.MaBaiHat %>" data-title="<%= s.TenBaiHat %>" data-artist="<%= s.TenCaSi %>" data-cover="<%= s.AnhBia || '' %>" data-vip="<%= s.IsVIP?'VIP':'FREE' %>">▶ Nghe thử</button><a class="btn btn-outline btn-small" href="/admin/songs/<%= s.MaBaiHat %>/edit">Sửa</a><form method="post" action="/admin/songs/<%= s.MaBaiHat %>/delete" data-confirm="Khóa/ẩn bài hát này? Dữ liệu vẫn được giữ trong CSDL."><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-small" type="submit">Xóa</button></form><% } else { %><form method="post" action="/admin/songs/<%= s.MaBaiHat %>/restore"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline btn-small" type="submit">Mở khóa</button></form><% } %></div></td></tr><% }) %>
<% if(!songs.length){ %><tr><td colspan="7">Không có bài hát thuộc bộ lọc này.</td></tr><% } %></tbody></table></div></section>
<section class="section" id="vip"><div class="section-heading"><h2>Duyệt đăng ký VIP</h2><span class="muted">Chỉ xác nhận yêu cầu sau khi kiểm tra trong bản demo.</span></div><div class="panel table-scroll"><table class="data-table"><thead><tr><th>Mã</th><th>Người đăng ký</th><th>Gói VIP</th><th>Giá</th><th>Thanh toán</th><th>Thao tác</th></tr></thead><tbody><% pending.forEach(p=>{ %><tr><td>#<%= p.MaDangKy %></td><td><%= p.HoTen %><br><small><%= p.Email %></small></td><td><%= p.TenGoi %> · <%= p.ThoiHan %> ngày</td><td><%= formatPrice(p.Gia) %></td><td><span class="status-tag tag-yellow">Đã báo thanh toán</span></td><td><div class="table-actions"><form method="post" action="/admin/vip/<%= p.MaDangKy %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary btn-small" type="submit">Xác nhận</button></form><form method="post" action="/admin/vip/<%= p.MaDangKy %>/reject" data-confirm="Từ chối yêu cầu đăng ký này?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-small" type="submit">Từ chối</button></form></div></td></tr><% }) %><% if(!pending.length){ %><tr><td colspan="6">Không có yêu cầu VIP đang chờ.</td></tr><% } %></tbody></table></div></section>
<%- include('../partials/footer') %>
