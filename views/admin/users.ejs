<%- include('../partials/header',{title,active:'admin-users'}) %>
<section class="page-heading"><span class="eyebrow">TÀI KHOẢN</span><h1>Quản lý người dùng</h1><p>Admin có thể tìm kiếm, xem quyền VIP hiện tại, khóa tài khoản kèm lý do và mở khóa khi cần.</p></section>
<div class="admin-metrics"><div class="metric-card"><span>Tổng người dùng</span><strong><%= totalUsers %></strong><small>Tài khoản có vai trò USER</small></div><div class="metric-card"><span>Kết quả hiện tại</span><strong><%= filteredUsers %></strong><small>Theo bộ lọc đang chọn</small></div></div>
<form class="filter-bar" method="get" action="/admin/users">
  <label class="search-field"><span>⌕</span><input type="search" name="q" maxlength="100" placeholder="Tìm họ tên hoặc email..." value="<%= search %>"></label>
  <select name="status" aria-label="Trạng thái tài khoản"><option value="ALL" <%= status==='ALL'?'selected':'' %>>Tất cả</option><option value="ACTIVE" <%= status==='ACTIVE'?'selected':'' %>>Đang hoạt động</option><option value="LOCKED" <%= status==='LOCKED'?'selected':'' %>>Đã khóa</option></select>
  <button class="btn btn-outline" type="submit">Lọc</button><a class="btn btn-ghost" href="/admin/users">Đặt lại</a>
</form>
<div class="notice-box">ⓘ <strong>Hết VIP không phải là khóa tài khoản.</strong> Hết VIP chỉ mất quyền nghe bài VIP; khóa tài khoản là quyết định quản trị và phải có lý do.</div>
<div class="panel table-scroll"><table class="data-table"><thead><tr><th>ID</th><th>Người dùng</th><th>VIP hiện tại</th><th>Trạng thái</th><th>Lý do khóa</th><th>Thao tác</th></tr></thead><tbody>
<% users.forEach(u=>{ const active=Boolean(u.TrangThai); %><tr><td>#<%= u.MaNguoiDung %></td><td><strong><%= u.HoTen %></strong><br><small><%= u.Email %></small></td><td><span class="status-tag <%= u.VIPHienTai?'tag-yellow':'tag-green' %>"><%= u.VIPHienTai?'VIP':'FREE' %></span></td><td><span class="status-tag <%= active?'tag-green':'tag-red' %>"><%= active?'Hoạt động':'Đã khóa' %></span></td><td><%= u.LyDoKhoa || '—' %></td><td><div class="table-actions"><% if(active){ %><form method="post" action="/admin/users/<%= u.MaNguoiDung %>/lock" data-confirm="Khóa tài khoản này?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="text" name="reason" required minlength="3" maxlength="255" placeholder="Lý do khóa"><button class="btn btn-danger btn-small" type="submit">Khóa</button></form><% } else { %><form method="post" action="/admin/users/<%= u.MaNguoiDung %>/unlock"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline btn-small" type="submit">Mở khóa</button></form><% } %></div></td></tr><% }) %>
<% if(!users.length){ %><tr><td colspan="6">Không có người dùng phù hợp.</td></tr><% } %></tbody></table></div>
<%- include('../partials/footer') %>
