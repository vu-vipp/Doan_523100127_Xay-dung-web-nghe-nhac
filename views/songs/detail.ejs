<%- include('../partials/header',{title,active:adminPreview?'admin-music':'songs'}) %>
<a class="back-link" href="<%= adminPreview?'/admin/music':'/songs' %>">← Quay lại <%= adminPreview?'Bài hát':'thư viện' %></a>
<section class="song-detail"><div class="detail-cover"><% if(song.AnhBia){ %><img src="<%= song.AnhBia %>" alt="Ảnh bìa <%= song.TenBaiHat %>"><% } else { %>♫<% } %></div><div><span class="eyebrow"><%= adminPreview?'ADMIN · NGHE THỬ':'BÀI HÁT' %> <%= song.IsVIP?'✦ VIP':'MIỄN PHÍ' %></span><h1><%= song.TenBaiHat %></h1><p class="muted"><%= song.TenCaSi %> · <%= song.TenTheLoai %></p><p><%= song.TenAlbum || 'Đĩa đơn' %> · <%= formatDuration(song.ThoiLuong) %> · <%= song.LuotNghe %> lượt nghe</p><div class="button-row"><button type="button" class="btn btn-primary play-trigger" data-play="<%= song.MaBaiHat %>" data-title="<%= song.TenBaiHat %>" data-artist="<%= song.TenCaSi %>" data-cover="<%= song.AnhBia || '' %>" data-vip="<%= song.IsVIP?'VIP':'FREE' %>">▶ <%= adminPreview?'Nghe thử bài hát':'Phát bài hát' %></button><% if(adminPreview){ %><a class="btn btn-outline" href="/admin/songs/<%= song.MaBaiHat %>/edit">✎ Sửa bài hát</a><% } else if(!viewer){ %><a class="btn btn-outline" href="/login">＋ Thêm vào playlist</a><% } else if(viewer.VaiTro!=='ADMIN'){ %><a class="btn btn-outline" href="/playlists">▤ Playlist của tôi</a><% } %></div>
<% if(viewer && viewer.VaiTro!=='ADMIN'){ %>
<details class="add-playlist" id="add-to-playlist">
  <summary class="btn btn-outline">＋ Thêm vào playlist</summary>
  <div class="add-playlist-content">
    <% if(playlists.length){ %>
      <form method="post" action="/songs/<%= song.MaBaiHat %>/playlist" class="add-playlist-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label for="playlist-select">Chọn playlist của bạn</label>
        <select id="playlist-select" name="playlistId" required>
          <% playlists.forEach(p=>{ %><option value="<%= p.MaPlaylist %>"><%= p.TenPlaylist %> (<%= p.SoBaiHat %> bài)</option><% }) %>
        </select>
        <button class="btn btn-primary" type="submit">Xác nhận thêm bài hát</button>
      </form>
    <% } else { %>
      <p>Bạn chưa có playlist. <a class="text-link" href="/playlists">Tạo playlist trước →</a></p>
    <% } %>
  </div>
</details>
<% } %>
</div></section>
<% if(adminPreview){ %><div class="notice-box success">✓ Chế độ kiểm tra Admin: được nghe thử cả bài hát FREE và VIP. Máy chủ vẫn kiểm tra vai trò trước khi cấp âm thanh VIP.</div><% } else if(song.IsVIP && !activeVIP) { %><div class="notice-box">✦ Đây là bài hát VIP. Bạn cần đăng ký và được Admin xác nhận gói còn hạn trước khi phát. <a href="/vip">Xem gói VIP →</a></div><% } %>
<%- include('../partials/footer') %>
